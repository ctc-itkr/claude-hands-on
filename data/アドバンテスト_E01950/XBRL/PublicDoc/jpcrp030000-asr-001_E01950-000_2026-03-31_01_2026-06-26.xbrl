&lt;p style="margin-left: 8px; line-height: 21.333333333333333333333333333px; margin-right: 72px; text-align: center; text-indent: 53.533333333333333333333333333px"&gt;時　　価&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 12px"&gt;
&lt;td style="vertical-align: top; width: 64px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;

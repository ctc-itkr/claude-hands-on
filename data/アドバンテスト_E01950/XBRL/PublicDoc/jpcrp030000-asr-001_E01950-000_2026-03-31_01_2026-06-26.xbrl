&lt;p style="line-height: 21.333333333333333333333333333px; text-align: center"&gt;転換価額&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="3" style="vertical-align: middle; width: 105.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21.333333333333333333333333333px; margin-right: 6.2666666666666666666666666667px; text-align: center"&gt;既発行株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 33.933333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;

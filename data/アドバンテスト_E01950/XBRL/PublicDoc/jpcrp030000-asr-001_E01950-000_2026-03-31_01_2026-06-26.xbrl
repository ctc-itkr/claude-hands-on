&lt;p style="margin-left: 28.4px; margin-right: 6px; text-align: justify; line-height: 13.333333333333333333333333333px; margin-bottom: 0.5em; margin-top: 0.5em; text-justify: inter-ideograph; text-indent: -18.933333333333333333333333333px"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;d.成長投資&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 133.53333333333333333333333333px; vertical-align: middle; padding-bottom: 1.8666666666666666666666666667px; padding-top: 0px; padding-left: 0px; padding-right: 1.8666666666666666666666666667px; background-color: #F2F2F2"&gt;

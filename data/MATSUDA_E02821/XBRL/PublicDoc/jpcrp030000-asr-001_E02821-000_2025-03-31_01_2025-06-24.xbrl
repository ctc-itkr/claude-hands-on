  <jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head5" style="orphans:0;widows:0;padding-left:18pt;"&gt;(資産除去債務関係)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;"&gt;金額的重要性が乏しいため、注記を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRealEstateForLeaseEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head5" style="orphans:0;widows:0;padding-left:18pt;"&gt;(賃貸等不動産関係)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;"&gt;金額的重要性が乏しいため、注記を省略しております。&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRealEstateForLeaseEtcConsolidatedFinancialStatementsTextBlock>

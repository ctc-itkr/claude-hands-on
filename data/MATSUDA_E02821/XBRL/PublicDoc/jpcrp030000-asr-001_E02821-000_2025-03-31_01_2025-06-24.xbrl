  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;(1) 売上高&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:415pt;"&gt;(単位：百万円)&lt;/p&gt;
&lt;div class="tbld"&gt;

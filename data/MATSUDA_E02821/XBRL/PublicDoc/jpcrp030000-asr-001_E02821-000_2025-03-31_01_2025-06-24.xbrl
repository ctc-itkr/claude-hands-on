&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:dotted;border-top-width:0.75pt;border-bottom-style:dotted;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:dotted;border-top-width:0.75pt;border-bottom-style:dotted;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:8pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-8pt;line-height:10pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;・ グローバル展開の加速で販売領域を拡大&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;

&lt;p style="margin-right: 6px; text-align: right"&gt;△6,131&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 162px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 2px solid #000000; border-bottom: 2px solid #000000"&gt;

&lt;td style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; width: 169.93333333333333333333333333px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;

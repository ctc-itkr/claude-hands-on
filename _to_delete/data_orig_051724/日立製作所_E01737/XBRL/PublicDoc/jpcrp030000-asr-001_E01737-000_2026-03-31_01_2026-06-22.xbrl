&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 231.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none ; background-color: #D6C6AF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;指　標&lt;/p&gt;

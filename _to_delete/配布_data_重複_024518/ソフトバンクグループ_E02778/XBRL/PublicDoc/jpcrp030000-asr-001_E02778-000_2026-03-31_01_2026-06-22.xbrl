&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 125px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;6,186,874&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 134px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;
&lt;span style="font-weight: bold"&gt;3,713,028&lt;/span&gt;
&lt;/p&gt;

&lt;tr style="height: 102px"&gt;
&lt;td style="vertical-align: top; width: 18px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 155.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;ソフトバンク事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 250.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・コンシューマ事業：個人顧客を対象としたモバイルサービスおよびブロードバンドサービスの提供&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・エンタープライズ事業：法人顧客を対象としたモバイルサービスやソリューションサービスの提供&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・ディストリビューション事業：法人顧客を対象としたICTサービス商材の提供&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・メディア・EC事業：メディア・広告やコマースサービスの提供&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・ファイナンス事業：決済、金融サービスの提供&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 224px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;ソフトバンク㈱&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;LINEヤフー㈱&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;PayPay㈱&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 84px"&gt;
&lt;td style="vertical-align: top; width: 18px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;

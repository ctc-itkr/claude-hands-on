&lt;td style="vertical-align: top; width: 264px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 15px; margin-right: 6px; text-align: left"&gt;第50回普通株式新株予約権&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 15px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;　当社従業員　１名&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 15px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;　当社子会社取締役その他の役員　26名&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 15px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;　当社子会社従業員　559名&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 25px"&gt;

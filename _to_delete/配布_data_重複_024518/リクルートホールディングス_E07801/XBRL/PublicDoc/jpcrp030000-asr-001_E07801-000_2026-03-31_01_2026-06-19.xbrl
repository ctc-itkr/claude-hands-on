&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;発行価格    1,061(注4)&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;資本組入額    531&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;同左&lt;/p&gt;

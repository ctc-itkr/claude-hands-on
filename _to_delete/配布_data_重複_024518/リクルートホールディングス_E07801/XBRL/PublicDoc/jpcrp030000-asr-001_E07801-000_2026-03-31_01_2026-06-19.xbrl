&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:40pt;min-height:40pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;font-size:12pt;"&gt;1962年&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;

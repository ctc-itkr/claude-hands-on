&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;実績&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;

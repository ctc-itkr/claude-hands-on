&lt;col style="width:63.9pt;min-width:63.9pt;"/&gt;
&lt;col style="width:63.9pt;min-width:63.9pt;"/&gt;
&lt;col style="width:45.9pt;min-width:45.9pt;"/&gt;
&lt;col style="width:55.9pt;min-width:55.9pt;"/&gt;
&lt;col style="width:81.9pt;min-width:81.9pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:21.8pt;min-height:21.8pt;"&gt;

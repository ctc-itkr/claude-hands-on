&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;font-size:12pt;"&gt;2025年&lt;/p&gt;

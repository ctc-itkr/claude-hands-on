&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;男性の育児休業等の取得率&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:9pt;"&gt;&lt;span style="color:#ffffff;"&gt;(注3)(注4) (%)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="3" style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#f2f2f2;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0.0pt;line-height:18.3pt;font-size:10.5pt;"&gt;&lt;span style="color:#ffffff;font-size:9pt;"&gt;男女間の賃金の差異(注3)(注5) (%)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;

&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 611px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 227px"/&gt;
&lt;col style="width: 128px"/&gt;
&lt;col style="width: 128px"/&gt;
&lt;col style="width: 128px"/&gt;
&lt;/colgroup&gt;

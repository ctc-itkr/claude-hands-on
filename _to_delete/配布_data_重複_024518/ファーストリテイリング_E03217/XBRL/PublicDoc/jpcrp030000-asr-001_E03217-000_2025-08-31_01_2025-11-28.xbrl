  <link:footnoteLink xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/rol_StatementOfIncome" xlink:type="extended">
    <link:footnote xlink:label="footnote" xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/role/NotesNumber" xlink:type="resource" xml:lang="ja">
<span style="font-size: 8px" xmlns="http://www.w3.org/1999/xhtml">※４</span>
</link:footnote>
    <link:loc xlink:href="#IdFact1720967365" xlink:label="fact" xlink:type="locator"/>
    <link:footnoteArc xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="fact" xlink:to="footnote" xlink:type="arc"/>
  </link:footnoteLink>

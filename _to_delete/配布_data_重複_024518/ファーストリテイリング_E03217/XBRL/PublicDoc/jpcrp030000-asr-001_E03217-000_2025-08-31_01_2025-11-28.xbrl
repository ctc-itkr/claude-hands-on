&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 64.866666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; margin-right: 2.6666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 8px"&gt;役位&lt;/span&gt;

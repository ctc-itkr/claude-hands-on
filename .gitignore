# EDINET の APIキー
key.txt

# macOS / Office の一時ファイル
.DS_Store
**/.DS_Store
~$*

# Python のキャッシュ
__pycache__/

# data は 配布/データ へのシンボリックリンク（各自の手元で作る）
/data

# fetch ツールの実行記録（配布不要）
edinet_fetch_manifest.json

# 配布用 zip（tools/make_dist_zip.sh で 配布/ から随時生成する）
*.zip

# Claude で作った試作ページ（手元専用）
/artifacts/

# 演習の出力（受講者が作る完成品。配布に含めない）
配布/データ/*/data.json
配布/データ/*/dashboard.html
配布/index.html
